<?xml version="1.0" encoding="UTF-8"?>
<!--
    Dette er en tilpasning av GeoServer sin PRODUCTION_LOGGING setup;
    https://github.com/geoserver/geoserver/blob/main/src/main/src/main/resources/PRODUCTION_LOGGING.xml
 -->
<Configuration name="JSON_STDOUT_LOGGING" status="warn" dest="err">
    <Appenders>
        <Console name="stdout" target="SYSTEM_OUT">
            <JsonLayout
                    compact="true"
                    eventEol="true"
                    complete="false"
                    properties="true"
                    stacktraceAsString="true"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="org.geotools" level="warn" additivity="false">
            <AppenderRef ref="stdout"/>
        </Logger>

        <Logger name="org.geotools.factory" level="warn" additivity="false">
            <AppenderRef ref="stdout"/>
        </Logger>

        <Logger name="org.geoserver" level="warn" additivity="false">
            <AppenderRef ref="stdout"/>
        </Logger>
        <Logger name="org.geoserver.config" level="warn" additivity="false">
            <AppenderRef ref="stdout"/>
        </Logger>
        <Logger name="org.vfny.geoserver" level="warn" additivity="false">
            <AppenderRef ref="stdout"/>
        </Logger>

        <Logger name="org.springframework" level="error" additivity="false">
            <AppenderRef ref="stdout"/>
        </Logger>

        <Logger name="org.geowebcache" level="error" additivity="false">
            <AppenderRef ref="stdout"/>
        </Logger>

        <Root level="warn">
            <AppenderRef ref="stdout"/>
        </Root>
    </Loggers>
</Configuration>